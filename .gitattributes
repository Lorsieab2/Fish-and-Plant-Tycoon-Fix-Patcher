# Bundled game assets are pinned by exact size and SHA-256, so git must store
# and check them out byte-for-byte. Line-ending conversion would change text
# files such as Images/stylesheet.css and make the pin refuse them.
assets/plant_tycoon_steam/** -text
assets/fish_tycoon_ds/** -text
assets/free_upgrades/** -text
assets/money_cheat/** -text
assets/time_warp/** -text
assets/fish_tycoon_window/** -text
assets/fish_tycoon_counts/** -text
assets/plant_tycoon_counts/** -text
assets/fish_tycoon_ornaments/** -text
assets/fish_tycoon_extra_tanks/** -text
assets/fish_tycoon_supply_slots/** -text
assets/plant_tycoon_greenhouses/*.ini -text
assets/everything_free/** -text
