  "settings": [
    {
      "id": "crimson_comet_20_percent_cure",
      "name": "Crimson Comet 20% curing fix",
      "description": "Repairs the cure roll, which the base game can never pass. The original code calls its random helper with an upper bound of 0, so no roll can come back under the threshold and a Crimson Comet never cures anything. The call is redirected to a wrapper that rolls 0-99 once per eligible diseased fish and cures on 0-19, a flat 20 percent. The disease clear and the cure counter behind it are the original code, unchanged. Touches 2 places: VA 0x4204CE and a 14-byte wrapper at VA 0x401E11.",
      "category": "main",
      "default": true
    },
    {
      "id": "unknown_chemical_three_uses",
      "name": "Unknown Chemical: 3 uses",
      "description": "Makes one Unknown Chemical purchase last three uses instead of one. The base game rewrites the remaining count to 1 every time the item is used, so simply raising the purchase amount would be undone on first use; that 10-byte write at VA 0x4210B7 is replaced with NOPs so the purchased count survives and decrements normally. The English store text is corrected to 'Contains 3 doses.' to match. Touches 2 places.",
      "category": "main",
      "default": true
    },
    {
      "id": "universal_supply_slots",
      "name": "Universal supply slots 2-4",
      "description": "Lets the eight supported medicines, chemicals, and egg types share supply slots 2-4 instead of each being locked to its own slot. Buying an item first looks for a matching stack in slots 2-4, then the first empty slot, and only then asks to replace something. The normal Buy confirmation still appears and cancelling changes nothing. Using an item swaps its record into the slot the original handler expects and swaps it back, so effects still run exactly once. Adds a 961-byte routine at the end of .text (VA 0x43F2A0) and rewrites the slot prompts to say 'item' in English and German. Touches 14 places.",
      "category": "main",
      "default": true
    },
    {
      "id": "golden_seahorse_repurchase",
      "name": "Golden Seahorse: allow repurchase",
      "description": "Lets the Golden Seahorse be bought again after you already own it. Selecting an owned store item normally hits the check at VA 0x4282B0, which shows the 'you already own this' message and stops. For store item 11, the Golden Seahorse, that check is skipped so the purchase continues as if the item were unowned; every other item keeps the original behaviour exactly. Nothing else needs changing: the seahorse's purchase-completion path at VA 0x42800E has no ownership check of its own. Touches 3 places: the gate at VA 0x4282B0, a 26-byte wrapper at VA 0x43F800, and the .text VirtualSize so that wrapper is mapped.",
      "category": "main",
      "default": false
    }
  ],
